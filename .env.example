# ByteArcadeR RepoGuard — Optional Environment Configuration
# All settings below have built-in defaults in server.ts.
# The application runs out-of-the-box without requiring any secrets or .env file.

# Server Port (Optional, default: 3000)
PORT=3000

# Cache TTL in seconds for repository analysis responses (Optional, default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# Request timeout in milliseconds for upstream GitHub REST API calls (Optional, default: 10000 = 10 seconds)
GITHUB_TIMEOUT_MS=10000

# Optional: Server-side GitHub Personal Access Token.
# Public GitHub repository analysis works without a token (60 requests/hr unauthenticated).
# Uncomment and set a token only if you need a higher rate limit (5,000 requests/hr).
# Never expose GITHUB_TOKEN to client-side code.
# GITHUB_TOKEN=
